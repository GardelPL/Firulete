-- Verified generic binary search over sorted `LIST[K]` (`K: ORD`) in idiomatic, pure, total Gardel.
--
-- Proves:
--   1. Overflow-safe midpoint arithmetic (`lo + (hi - lo) / 2`) and strict termination (`hi - lo`).
--   2. Soundness: `Some(idx)` implies `idx` is in bounds, `LIST_OPS.at(xs, idx).equals(target)`,
--      and `target` and `LIST_OPS.at(xs, idx)` are order-equivalent.
--   3. Completeness: whenever `K`'s `equals` is congruent with `less_than` (which holds for all
--      standard ordered types such as `I64`, `NAT`, `CHAR`, and `STRING`), `None` implies every
--      element in the searched range is not `.equals(target)`.
module BINARY_SEARCH[K: ORD]

create {ANY}

  -- True when every element of `xs` is `>= lo` (i.e. not strictly less than `lo`).
  all_ge(lo: K, xs: LIST[K]): BOOL
    variant
      xs.length
    do
      if xs.length = 0 then
        True
      else
        (not xs.head.less_than(lo)) and BINARY_SEARCH.all_ge(lo, xs.tail)
      end
    ensure
      empty_case: xs.length = 0 implies Result
      cons_case: xs.length > 0 implies
        (Result = ((not xs.head.less_than(lo)) and BINARY_SEARCH.all_ge(lo, xs.tail)))
    end

  -- True when `xs` is sorted in non-decreasing order (`not xs[j].less_than(xs[i])` for `i <= j`).
  -- Matches the sortedness predicate of `INSERTION_SORT[K: ORD]`.
  is_sorted(xs: LIST[K]): BOOL
    variant
      xs.length
    do
      if xs.length = 0 then
        True
      else
        BINARY_SEARCH.all_ge(xs.head, xs.tail) and BINARY_SEARCH.is_sorted(xs.tail)
      end
    ensure
      empty_case: xs.length = 0 implies Result
      single_case: xs.length = 1 implies Result
      cons_case: xs.length > 0 implies
        (Result = (BINARY_SEARCH.all_ge(xs.head, xs.tail) and BINARY_SEARCH.is_sorted(xs.tail)))
    end

  -- Search for `target` in the half-open index range `[lo, hi)` of sorted `xs`.
  -- Returns `Some(idx)` with `lo <= idx < hi` and `LIST_OPS.at(xs, idx).equals(target)`,
  -- or `None` if no matching element exists in `[lo, hi)`.
  search_range(xs: LIST[K], target: K, lo: NAT, hi: NAT): OPTION[NAT]
    require
      ordered_bounds: lo <= hi
      in_bounds: hi <= xs.length
      sorted: BINARY_SEARCH.is_sorted(xs)
    variant
      hi - lo
    do
      if lo = hi then
        None
      else
        let mid = lo + (hi - lo) / 2
        let mid_val = LIST_OPS.at(xs, mid)
        if target.less_than(mid_val) then
          check
            sorted_right: BINARY_SEARCH.sorted_all_above(xs, mid)
          end
          BINARY_SEARCH.search_range(xs, target, lo, mid)
        else if mid_val.less_than(target) then
          check
            sorted_left: BINARY_SEARCH.sorted_all_below(xs, mid)
          end
          BINARY_SEARCH.search_range(xs, target, mid + 1, hi)
        else
          Some(mid)
        end end
      end
    ensure
      found_in_bounds: Result.is_some implies (lo <= Result.get and Result.get < hi)
      found_matches: Result.is_some implies
        (LIST_OPS.at(xs, Result.get).equals(target) and
         (not target.less_than(LIST_OPS.at(xs, Result.get))) and
         (not LIST_OPS.at(xs, Result.get).less_than(target)))
      absent_means_missing:
        (Result.is_none and
         (forall a: K. (a.equals(a) implies
           (forall b: K. (b.equals(b) implies
             (forall c: K.
               ((a.equals(b) and b.less_than(c)) implies a.less_than(c)) and
               ((a.less_than(b) and b.equals(c)) implies a.less_than(c)))))))) implies
        (forall i: NAT. (lo <= i and i < hi) implies not LIST_OPS.at(xs, i).equals(target))
    end

  -- Search all of sorted `xs` for `target`.
  search(xs: LIST[K], target: K): OPTION[NAT]
    require
      sorted: BINARY_SEARCH.is_sorted(xs)
      fits: xs.length <= 18446744073709551615
    do
      BINARY_SEARCH.search_range(xs, target, 0, xs.length)
    ensure
      found_in_bounds: Result.is_some implies Result.get < xs.length
      found_matches: Result.is_some implies
        (LIST_OPS.at(xs, Result.get).equals(target) and
         (not target.less_than(LIST_OPS.at(xs, Result.get))) and
         (not LIST_OPS.at(xs, Result.get).less_than(target)))
      absent_means_missing:
        (Result.is_none and
         (forall a: K. (a.equals(a) implies
           (forall b: K. (b.equals(b) implies
             (forall c: K.
               ((a.equals(b) and b.less_than(c)) implies a.less_than(c)) and
               ((a.less_than(b) and b.equals(c)) implies a.less_than(c)))))))) implies
        (forall i: NAT. i < xs.length implies not LIST_OPS.at(xs, i).equals(target))
    end

  -- True if `target` occurs in sorted `xs`.
  contains(xs: LIST[K], target: K): BOOL
    require
      sorted: BINARY_SEARCH.is_sorted(xs)
      fits: xs.length <= 18446744073709551615
    do
      BINARY_SEARCH.search(xs, target).is_some
    ensure
      found_implies_present: Result implies
        (not (forall i: NAT. i < xs.length implies not LIST_OPS.at(xs, i).equals(target)))
      congruent_iff:
        (forall a: K. (a.equals(a) implies
          (forall b: K. (b.equals(b) implies
            (forall c: K.
              ((a.equals(b) and b.less_than(c)) implies a.less_than(c)) and
              ((a.less_than(b) and b.equals(c)) implies a.less_than(c))))))) implies
        (Result = (not (forall i: NAT. i < xs.length implies not LIST_OPS.at(xs, i).equals(target))))
    end

create {NONE}

  all_ge_all(lo: K, xs: LIST[K]): BOOL
    variant
      xs.length
    do
      if xs.length = 0 then
        True
      else
        check
          rec_all: BINARY_SEARCH.all_ge_all(lo, xs.tail)
        end
        True
      end
    ensure
      holds: Result
      above: BINARY_SEARCH.all_ge(lo, xs) implies
        (forall j: NAT. j < xs.length implies not LIST_OPS.at(xs, j).less_than(lo))
    end

  sorted_all_above(xs: LIST[K], idx: NAT): BOOL
    variant
      xs.length
    do
      if xs.length <= 1 or idx >= xs.length then
        True
      else if idx = 0 then
        check
          tail_above: BINARY_SEARCH.all_ge_all(xs.head, xs.tail)
        end
        True
      else
        check
          rec_above: BINARY_SEARCH.sorted_all_above(xs.tail, idx - 1)
        end
        True
      end end
    ensure
      holds: Result
      above: (BINARY_SEARCH.is_sorted(xs) and idx < xs.length) implies
        (forall j: NAT. (idx <= j and j < xs.length) implies
          not LIST_OPS.at(xs, j).less_than(LIST_OPS.at(xs, idx)))
    end

  sorted_all_below(xs: LIST[K], idx: NAT): BOOL
    variant
      xs.length
    do
      if xs.length <= 1 or idx >= xs.length then
        True
      else if idx = 0 then
        True
      else
        let first_tail = LIST_OPS.at(xs.tail, 0)
        check
          tail_above: BINARY_SEARCH.all_ge_all(xs.head, xs.tail)
          rec_below: BINARY_SEARCH.sorted_all_below(xs.tail, idx - 1)
          first_eq: first_tail = xs.tail.head
        end
        True
      end end
    ensure
      holds: Result
      below: (BINARY_SEARCH.is_sorted(xs) and idx < xs.length) implies
        (forall i: NAT. i <= idx implies
          not LIST_OPS.at(xs, idx).less_than(LIST_OPS.at(xs, i)))
    end

end
