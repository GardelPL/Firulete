-- Runs the run tests of every `*_TEST` suite and reports each by name.
--
--   ./firulete/test.ps1                        # verify everything, then run all suites
--   ./firulete/test.ps1 binary_search          # verify everything, then run one suite
--
-- Spec tests need no runner: they are proved when this package is compiled.
--
-- Output: one `PASS <suite>` / `FAIL <suite> (case n)` / `SKIP <suite>` line per suite.
-- Exit code: 0 if every selected suite passed, 1 if any failed, 2 if no suite matched the filter.
--
-- To add a suite: write `tests/src/<algo>_test.gdl` (`functions <ALGO>_TEST` with `run: NAT`),
-- then add its `wanted` / `rc` / `failed` / `print_line` lines to `main`, and its name to the
-- "known suites" message.
program FIRULETE_TEST

feature {ANY}

  -- `a` then `b`, or `a` alone if that would not fit.
  join(a: STRING, b: STRING): STRING
    do
      if a.byte_length <= 100000000 and b.byte_length <= 100000000 then a.concat(b) else a end
    end

  -- A suite runs when no filter is given or the filter names it.
  wanted(filter: LIST[STRING], name: STRING): BOOL
    do
      filter.length = 0 or TEST_LIST.has(filter, name)
    end

  line(name: STRING, selected: BOOL, code: NAT): STRING
    do
      if not selected then
        join("SKIP ", name)
      else if code = 0 then
        join("PASS ", name)
      else
        join(join(join(join("FAIL ", name), " (case "), NUMBER_TEXT.nat_to_text(code)), ")")
      end end
    end

  failed(selected: BOOL, code: NAT): NAT
    do
      if selected and code != 0 then 1 else 0 end
    ensure
      at_most_one: Result <= 1
    end

  main(args: SEQ[STRING]): IO[EXIT_CODE]
    do
      let filter = args.to_list
      let w_is = wanted(filter, "insertion_sort")
      let w_bs = wanted(filter, "binary_search")
      let w_ms = wanted(filter, "merge_sort")
      let w_qs = wanted(filter, "quicksort")
      let w_bh = wanted(filter, "binary_heap")
      let w_bq = wanted(filter, "bounded_queue")
      let w_mx = wanted(filter, "max_subarray")
      let w_mm = wanted(filter, "min_max")
      let w_sm = wanted(filter, "simultaneous_min_max")
      let w_st = wanted(filter, "bounded_stack")
      let w_gc = wanted(filter, "gcd")
      let w_ns = wanted(filter, "naive_string_match")
      let w_ll = wanted(filter, "linked_list_ops")
      let w_hs = wanted(filter, "heapsort")
      let rc_is = if w_is then INSERTION_SORT_TEST.run else 0 end
      let rc_bs = if w_bs then BINARY_SEARCH_TEST.run else 0 end
      let rc_ms = if w_ms then MERGE_SORT_TEST.run else 0 end
      let rc_qs = if w_qs then QUICKSORT_TEST.run else 0 end
      let rc_bh = if w_bh then BINARY_HEAP_TEST.run else 0 end
      let rc_bq = if w_bq then BOUNDED_QUEUE_TEST.run else 0 end
      let rc_mx = if w_mx then MAX_SUBARRAY_TEST.run else 0 end
      let rc_mm = if w_mm then MIN_MAX_TEST.run else 0 end
      let rc_sm = if w_sm then SIMULTANEOUS_MIN_MAX_TEST.run else 0 end
      let rc_st = if w_st then BOUNDED_STACK_TEST.run else 0 end
      let rc_gc = if w_gc then GCD_TEST.run else 0 end
      let rc_ns = if w_ns then NAIVE_STRING_MATCH_TEST.run else 0 end
      let rc_ll = if w_ll then LINKED_LIST_OPS_TEST.run else 0 end
      let rc_hs = if w_hs then HEAPSORT_TEST.run else 0 end
      let failures = failed(w_is, rc_is) + failed(w_bs, rc_bs) + failed(w_ms, rc_ms) + failed(w_qs, rc_qs) + failed(w_bh, rc_bh) + failed(w_bq, rc_bq) + failed(w_mx, rc_mx) + failed(w_mm, rc_mm) + failed(w_sm, rc_sm) + failed(w_st, rc_st) + failed(w_gc, rc_gc) + failed(w_ns, rc_ns) + failed(w_ll, rc_ll) + failed(w_hs, rc_hs)
      if not (w_is or w_bs or w_ms or w_qs or w_bh or w_bq or w_mx or w_mm or w_sm or w_st or w_gc or w_ns or w_ll or w_hs) then
        with IO
          IO.print_line("firulete-tests: no suite matches the filter; known suites:")
          IO.print_line("  insertion_sort binary_search merge_sort quicksort binary_heap bounded_queue max_subarray")
          IO.print_line("  min_max simultaneous_min_max bounded_stack gcd naive_string_match linked_list_ops heapsort")
          IO.exit(2)
        end
      else
        with IO
          IO.print_line(line("insertion_sort", w_is, rc_is))
          IO.print_line(line("binary_search", w_bs, rc_bs))
          IO.print_line(line("merge_sort", w_ms, rc_ms))
          IO.print_line(line("quicksort", w_qs, rc_qs))
          IO.print_line(line("binary_heap", w_bh, rc_bh))
          IO.print_line(line("bounded_queue", w_bq, rc_bq))
          IO.print_line(line("max_subarray", w_mx, rc_mx))
          IO.print_line(line("min_max", w_mm, rc_mm))
          IO.print_line(line("simultaneous_min_max", w_sm, rc_sm))
          IO.print_line(line("bounded_stack", w_st, rc_st))
          IO.print_line(line("gcd", w_gc, rc_gc))
          IO.print_line(line("naive_string_match", w_ns, rc_ns))
          IO.print_line(line("linked_list_ops", w_ll, rc_ll))
          IO.print_line(line("heapsort", w_hs, rc_hs))
          if failures = 0 then
            with IO
              IO.print_line("firulete-tests: all selected suites passed")
              IO.exit(0)
            end
          else
            with IO
              IO.print_line(join(NUMBER_TEXT.nat_to_text(failures), " suite(s) failed"))
              IO.exit(1)
            end
          end
        end
      end
    end

end
