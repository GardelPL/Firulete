-- Tests for `MERGE_SORT[K: ORD]` (`src/merge_sort.gdl`).
--
-- Spec tests (`spec_*`) are proved from `MERGE_SORT`'s public contracts only; run tests (`run`)
-- execute the compiled code and return 0 or the first failing case. See
-- `insertion_sort_test.gdl` for the conventions.
functions MERGE_SORT_TEST

feature {ANY}

  -- ---------------------------------------------------------------- spec tests (static)

  -- The contract alone determines the output of `sort` on a concrete input.
  spec_sort_concrete: BOOL
    do
      let e: LIST[I64] = LIST.empty
      let input = e.prepend(2).prepend(1).prepend(3)
      let expected = e.prepend(3).prepend(2).prepend(1)
      check s1_sorted_output: MERGE_SORT.sort(input) = expected end
      True
    ensure
      holds: Result
    end

  -- The contract alone determines `merge` on concrete sorted inputs.
  spec_merge_concrete: BOOL
    do
      let e: LIST[I64] = LIST.empty
      let a = e.prepend(5).prepend(1)
      let b = e.prepend(4).prepend(2)
      let expected = e.prepend(5).prepend(4).prepend(2).prepend(1)
      check s2_merged: MERGE_SORT.merge(a, b) = expected end
      True
    ensure
      holds: Result
    end

  -- Permutation is part of `sort`'s own contract: no lemma call is needed (compare
  -- `INSERTION_SORT_TEST.spec_sort_is_permutation`).
  spec_sort_is_permutation(xs: LIST[STRING], y: STRING): BOOL
    do
      True
    ensure
      holds: Result
      same_length: MERGE_SORT.sort(xs).length = xs.length
      same_count: INSERTION_SORT.count_of(y, MERGE_SORT.sort(xs)) = INSERTION_SORT.count_of(y, xs)
      adjacent: MERGE_SORT.adjacent_sorted(MERGE_SORT.sort(xs))
    end

  -- At `I64` the congruence hypothesis holds, so the output is sorted in the same sense as
  -- `INSERTION_SORT.is_sorted`.
  spec_sorted_i64(xs: LIST[I64]): BOOL
    do
      check
        s4_congruent: forall a: I64. (a.equals(a) implies
          (forall b: I64. (b.equals(b) implies
            (forall c: I64.
              ((a.equals(b) and b.less_than(c)) implies a.less_than(c)) and
              ((a.less_than(b) and b.equals(c)) implies a.less_than(c))))))
      end
      True
    ensure
      holds: Result
      sorted: INSERTION_SORT.is_sorted(MERGE_SORT.sort(xs))
    end

  -- ---------------------------------------------------------------- run tests (executed)

  run: NAT
    do
      let e: LIST[I64] = LIST.empty
      let one = e.prepend(42)
      let sorted_in = e.prepend(4).prepend(3).prepend(2).prepend(1)
      let rev_in = e.prepend(1).prepend(2).prepend(3).prepend(4).prepend(5)
      let rev_exp = e.prepend(5).prepend(4).prepend(3).prepend(2).prepend(1)
      let dup_in = e.prepend(0).prepend(-1).prepend(3).prepend(2).prepend(-1).prepend(3)
      let dup_exp = e.prepend(3).prepend(3).prepend(2).prepend(0).prepend(-1).prepend(-1)
      let two_in = e.prepend(-9223372036854775808).prepend(9223372036854775807)
      let two_exp = e.prepend(9223372036854775807).prepend(-9223372036854775808)
      let s_dup = MERGE_SORT.sort(dup_in)
      let ma = e.prepend(7).prepend(3).prepend(1)
      let mb = e.prepend(8).prepend(3).prepend(2)
      let m_exp = e.prepend(8).prepend(7).prepend(3).prepend(3).prepend(2).prepend(1)
      let es: LIST[STRING] = LIST.empty
      let str_in = es.prepend("b").prepend("delta").prepend("c").prepend("a").prepend("alpha")
      let str_exp = es.prepend("delta").prepend("c").prepend("b").prepend("alpha").prepend("a")
      -- 1500 values with repeats: merge sort must agree with insertion sort.
      let big = TEST_DATA.scrambled(1500)
      let big_ms = MERGE_SORT.sort(big)
      let big_is = INSERTION_SORT.sort(big)

      if not TEST_LIST.same(MERGE_SORT.sort(e), e) then 1
      else if not TEST_LIST.same(MERGE_SORT.sort(one), one) then 2
      else if not TEST_LIST.same(MERGE_SORT.sort(sorted_in), sorted_in) then 3
      else if not TEST_LIST.same(MERGE_SORT.sort(rev_in), rev_exp) then 4
      else if not TEST_LIST.same(s_dup, dup_exp) then 5
      else if not TEST_LIST.same(MERGE_SORT.sort(two_in), two_exp) then 6
      else if not TEST_LIST.same(MERGE_SORT.merge(ma, mb), m_exp) then 7
      else if not TEST_LIST.same(MERGE_SORT.merge(e, mb), mb) then 8
      else if not TEST_LIST.same(MERGE_SORT.merge(ma, e), ma) then 9
      else if not MERGE_SORT.adjacent_sorted(s_dup) then 10
      else if MERGE_SORT.adjacent_sorted(dup_in) then 11
      else if not TEST_LIST.same(MERGE_SORT.sort(str_in), str_exp) then 12
      else if big_ms.length != 1500 then 13
      else if not INSERTION_SORT.is_sorted(big_ms) then 14
      else if not TEST_LIST.same(big_ms, big_is) then 15
      else 0
      end end end end end end end end end end end end end end end
    end

end
