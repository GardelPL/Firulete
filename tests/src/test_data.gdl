-- Generated inputs shared by the `*_TEST` suites.
functions TEST_DATA

feature {ANY}

  -- `n` values in `[0, 1009)` in scrambled order, with repeats once `n > 1009`.
  scrambled(n: NAT): LIST[NAT]
    require
      small: n <= 1000000
    variant
      n
    do
      if n = 0 then
        LIST.empty
      else
        let rest = TEST_DATA.scrambled(n - 1)
        rest.prepend((n * 7919) % 1009)
      end
    end

  -- `i, i + 1, ..., n - 1` in ascending order: the worst case for a head-pivot quicksort.
  ascending(i: NAT, n: NAT): LIST[NAT]
    variant
      n - i
    do
      if i >= n then
        LIST.empty
      else
        let rest = TEST_DATA.ascending(i + 1, n)
        rest.prepend(i)
      end
    end

end
