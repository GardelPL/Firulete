-- Tests for `INSERTION_SORT[K: ORD]` (`src/insertion_sort.gdl`).
--
-- Spec tests (`spec_*`) are proved by `gardelc --strict` when the suite is compiled. This package
-- sees only `INSERTION_SORT`'s contracts, never its bodies, so a spec test passes only if the
-- public `ensure` clauses are strong enough to pin down the answer. A weaker contract fails here.
--
-- Run tests (`run`) execute the compiled C code. `run` returns 0, or the number of the first
-- failing case.
functions INSERTION_SORT_TEST

feature {ANY}

  -- ---------------------------------------------------------------- spec tests (static)

  -- The contract alone determines the output of `sort` on a concrete input.
  spec_sort_concrete: BOOL
    do
      let e: LIST[I64] = LIST.empty
      let input = e.prepend(2).prepend(1).prepend(3)
      let expected = e.prepend(3).prepend(2).prepend(1)
      check s1_sorted_output: INSERTION_SORT.sort(input) = expected end
      True
    ensure
      holds: Result
    end

  -- Counts are visible to clients and evaluate on concrete lists.
  spec_count_concrete: BOOL
    do
      let e: LIST[I64] = LIST.empty
      let xs = e.prepend(1).prepend(2).prepend(1)
      check
        s2_count_one: INSERTION_SORT.count_of(1, xs) = 2
        s2_count_two: INSERTION_SORT.count_of(2, xs) = 1
        s2_count_absent: INSERTION_SORT.count_of(7, xs) = 0
      end
      True
    ensure
      holds: Result
    end

  -- For every input and every element: the output is sorted, has the same length, and holds
  -- each element as many times as the input (multiset preservation via the `sort_count` lemma).
  spec_sort_is_permutation(xs: LIST[I64], y: I64): BOOL
    do
      check s3_lemma: INSERTION_SORT.sort_count(y, xs) end
      True
    ensure
      holds: Result
      sorted: INSERTION_SORT.is_sorted(INSERTION_SORT.sort(xs))
      same_length: INSERTION_SORT.sort(xs).length = xs.length
      same_count: INSERTION_SORT.count_of(y, INSERTION_SORT.sort(xs)) = INSERTION_SORT.count_of(y, xs)
    end

  -- Sorting a sorted list yields a sorted list of the same length (generic in `K`).
  spec_sort_generic_nat(xs: LIST[NAT]): BOOL
    do
      True
    ensure
      holds: Result
      sorted: INSERTION_SORT.is_sorted(INSERTION_SORT.sort(xs))
      same_length: INSERTION_SORT.sort(xs).length = xs.length
    end

  -- ---------------------------------------------------------------- run tests (executed)

  run: NAT
    do
      let e: LIST[I64] = LIST.empty
      let one = e.prepend(42)
      let sorted_in = e.prepend(4).prepend(3).prepend(2).prepend(1)
      let rev_in = e.prepend(1).prepend(2).prepend(3).prepend(4).prepend(5)
      let rev_exp = e.prepend(5).prepend(4).prepend(3).prepend(2).prepend(1)
      let dup_in = e.prepend(0).prepend(-1).prepend(3).prepend(2).prepend(-1).prepend(3)
      let dup_exp = e.prepend(3).prepend(3).prepend(2).prepend(0).prepend(-1).prepend(-1)
      let s_dup = INSERTION_SORT.sort(dup_in)
      let base = e.prepend(8).prepend(5).prepend(2)
      let exp_front = e.prepend(8).prepend(5).prepend(2).prepend(1)
      let exp_mid = e.prepend(8).prepend(6).prepend(5).prepend(2)
      let exp_back = e.prepend(10).prepend(8).prepend(5).prepend(2)
      let en: LIST[NAT] = LIST.empty
      let nat_in = en.prepend(1).prepend(5).prepend(1).prepend(9)
      let nat_exp = en.prepend(9).prepend(5).prepend(1).prepend(1)
      let s_nat = INSERTION_SORT.sort(nat_in)
      let es: LIST[STRING] = LIST.empty
      let str_in = es.prepend("b").prepend("c").prepend("a")
      let str_exp = es.prepend("c").prepend("b").prepend("a")

      if not TEST_LIST.same(INSERTION_SORT.sort(e), e) then 1
      else if not TEST_LIST.same(INSERTION_SORT.sort(one), one) then 2
      else if not TEST_LIST.same(INSERTION_SORT.sort(sorted_in), sorted_in) then 3
      else if not TEST_LIST.same(INSERTION_SORT.sort(rev_in), rev_exp) then 4
      else if not TEST_LIST.same(s_dup, dup_exp) then 5
      else if not TEST_LIST.same(INSERTION_SORT.insert(1, base), exp_front) then 6
      else if not TEST_LIST.same(INSERTION_SORT.insert(6, base), exp_mid) then 7
      else if not TEST_LIST.same(INSERTION_SORT.insert(10, base), exp_back) then 8
      else if not TEST_LIST.same(s_nat, nat_exp) then 9
      else if not INSERTION_SORT.is_sorted(s_dup) then 10
      else if not INSERTION_SORT.is_sorted(s_nat) then 11
      else if INSERTION_SORT.is_sorted(dup_in) then 12
      else if not TEST_LIST.same(INSERTION_SORT.sort(str_in), str_exp) then 13
      else 0
      end end end end end end end end end end end end end
    end

end
