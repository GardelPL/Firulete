-- Tests for `SIMULTANEOUS_MIN_MAX[K: ORD]` (`src/simultaneous_min_max.gdl`). See
-- `insertion_sort_test.gdl` for the conventions.
functions SIMULTANEOUS_MIN_MAX_TEST

feature {ANY}

  -- ---------------------------------------------------------------- spec tests (static)

  -- Both results are elements, for every `ORD` (here `STRING`, no hypothesis).
  spec_members(xs: LIST[STRING]): BOOL
    require
      nonempty: xs.length > 0
    do
      True
    ensure
      holds: Result
      lo_member: INSERTION_SORT.count_of(SIMULTANEOUS_MIN_MAX.of(xs).lo, xs) >= 1
      hi_member: INSERTION_SORT.count_of(SIMULTANEOUS_MIN_MAX.of(xs).hi, xs) >= 1
    end

  -- At `I64` the congruence hypothesis holds, so `lo` / `hi` bound every element.
  spec_bounds_i64(xs: LIST[I64]): BOOL
    require
      nonempty: xs.length > 0
    do
      check
        s2_congruent: forall c1: I64. (c1.equals(c1) implies
          (forall c2: I64. (c2.equals(c2) implies
            (forall c3: I64.
              ((c1.equals(c2) and c2.less_than(c3)) implies c1.less_than(c3)) and
              ((c1.less_than(c2) and c2.equals(c3)) implies c1.less_than(c3))))))
      end
      True
    ensure
      holds: Result
      least: INSERTION_SORT.all_ge(SIMULTANEOUS_MIN_MAX.of(xs).lo, xs)
      greatest: MIN_MAX.all_le(SIMULTANEOUS_MIN_MAX.of(xs).hi, xs)
    end

  -- ---------------------------------------------------------------- run tests (executed)

  -- `of(xs)` is `(lo, hi)`.
  is(xs: LIST[I64], lo: I64, hi: I64): BOOL
    do
      xs.length > 0 and SIMULTANEOUS_MIN_MAX.of(xs).lo = lo and SIMULTANEOUS_MIN_MAX.of(xs).hi = hi
    end

  -- `a` equals `b` (a typed helper: `.equals` on a value read from a generic module's feature
  -- currently fails verifier translation; see README "Compiler Limitations").
  same_str(a: STRING, b: STRING): BOOL
    do
      a.equals(b)
    end

  run: NAT
    do
      let e: LIST[I64] = LIST.empty
      let odd = e.prepend(0).prepend(-1).prepend(3).prepend(2).prepend(-1)
      let even = e.prepend(0).prepend(-1).prepend(3).prepend(2).prepend(-1).prepend(3)
      let desc = e.prepend(1).prepend(2).prepend(3).prepend(4)
      let ext = e.prepend(-9223372036854775808).prepend(9223372036854775807)
      let es: LIST[STRING] = LIST.empty
      let strs = es.prepend("b").prepend("delta").prepend("c").prepend("a").prepend("alpha")
      let big = TEST_DATA.scrambled(1501)
      let r_big = SIMULTANEOUS_MIN_MAX.of(big)
      let r_str = SIMULTANEOUS_MIN_MAX.of(strs)

      if not SIMULTANEOUS_MIN_MAX_TEST.is(e.prepend(7), 7, 7) then 1
      else if not SIMULTANEOUS_MIN_MAX_TEST.is(e.prepend(5).prepend(9), 5, 9) then 2
      else if not SIMULTANEOUS_MIN_MAX_TEST.is(odd, -1, 3) then 3
      else if not SIMULTANEOUS_MIN_MAX_TEST.is(even, -1, 3) then 4
      else if not SIMULTANEOUS_MIN_MAX_TEST.is(desc, 1, 4) then 5
      else if not SIMULTANEOUS_MIN_MAX_TEST.is(ext, -9223372036854775808, 9223372036854775807) then 6
      else if not SIMULTANEOUS_MIN_MAX_TEST.same_str(r_str.lo, "a") or not SIMULTANEOUS_MIN_MAX_TEST.same_str(r_str.hi, "delta") then 7
      else if r_big.lo != MIN_MAX.minimum(big) or r_big.hi != MIN_MAX.maximum(big) then 8
      else 0
      end end end end end end end end
    end

end
