-- Tests for `QUICKSORT[K: ORD]` (`src/quicksort.gdl`).
--
-- Spec tests (`spec_*`) are proved from `QUICKSORT`'s public contracts only; run tests (`run`)
-- execute the compiled code and return 0 or the first failing case. See
-- `insertion_sort_test.gdl` for the conventions.
functions QUICKSORT_TEST

feature {ANY}

  -- ---------------------------------------------------------------- spec tests (static)

  -- The contract alone determines the output of `sort` on a concrete input.
  spec_sort_concrete: BOOL
    do
      let e: LIST[I64] = LIST.empty
      let input = e.prepend(2).prepend(1).prepend(3)
      let expected = e.prepend(3).prepend(2).prepend(1)
      check s1_sorted_output: QUICKSORT.sort(input) = expected end
      True
    ensure
      holds: Result
    end

  -- The contract alone determines the partition around a pivot, order kept.
  spec_partition_concrete: BOOL
    do
      let e: LIST[I64] = LIST.empty
      let xs = e.prepend(4).prepend(1).prepend(5).prepend(3).prepend(0)
      let lo_exp = e.prepend(1).prepend(0)
      let hi_exp = e.prepend(4).prepend(5).prepend(3)
      check
        s2_below: QUICKSORT.below(3, xs) = lo_exp
        s2_above: QUICKSORT.at_or_above(3, xs) = hi_exp
      end
      True
    ensure
      holds: Result
    end

  -- Full sortedness and permutation hold for every `ORD`, here at `STRING`, with no
  -- congruence hypothesis (compare `MERGE_SORT_TEST.spec_sorted_i64`).
  spec_sort_correct(xs: LIST[STRING], y: STRING): BOOL
    do
      True
    ensure
      holds: Result
      sorted: INSERTION_SORT.is_sorted(QUICKSORT.sort(xs))
      same_length: QUICKSORT.sort(xs).length = xs.length
      same_count: INSERTION_SORT.count_of(y, QUICKSORT.sort(xs)) = INSERTION_SORT.count_of(y, xs)
    end

  -- The partition contract: everything below the pivot is `< p`, nothing else is.
  spec_partition_bounds(p: NAT, xs: LIST[NAT]): BOOL
    do
      True
    ensure
      holds: Result
      lo_bounded: QUICKSORT.all_lt(p, QUICKSORT.below(p, xs))
      hi_bounded: INSERTION_SORT.all_ge(p, QUICKSORT.at_or_above(p, xs))
    end

  -- ---------------------------------------------------------------- run tests (executed)

  run: NAT
    do
      let e: LIST[I64] = LIST.empty
      let one = e.prepend(42)
      let sorted_in = e.prepend(4).prepend(3).prepend(2).prepend(1)
      let rev_in = e.prepend(1).prepend(2).prepend(3).prepend(4).prepend(5)
      let rev_exp = e.prepend(5).prepend(4).prepend(3).prepend(2).prepend(1)
      let dup_in = e.prepend(0).prepend(-1).prepend(3).prepend(2).prepend(-1).prepend(3)
      let dup_exp = e.prepend(3).prepend(3).prepend(2).prepend(0).prepend(-1).prepend(-1)
      let same_in = e.prepend(7).prepend(7).prepend(7)
      let two_in = e.prepend(-9223372036854775808).prepend(9223372036854775807)
      let two_exp = e.prepend(9223372036854775807).prepend(-9223372036854775808)
      let s_dup = QUICKSORT.sort(dup_in)
      let part_in = e.prepend(4).prepend(1).prepend(5).prepend(3).prepend(0)
      let lo_exp = e.prepend(1).prepend(0)
      let hi_exp = e.prepend(4).prepend(5).prepend(3)
      let es: LIST[STRING] = LIST.empty
      let str_in = es.prepend("b").prepend("delta").prepend("c").prepend("a").prepend("alpha")
      let str_exp = es.prepend("delta").prepend("c").prepend("b").prepend("alpha").prepend("a")
      -- 1500 values with repeats: all three sorts must agree.
      let big = TEST_DATA.scrambled(1500)
      let big_qs = QUICKSORT.sort(big)
      let big_ms = MERGE_SORT.sort(big)
      -- Worst case for a head pivot (recursion depth n).
      let asc = TEST_DATA.ascending(0, 1000)

      if not TEST_LIST.same(QUICKSORT.sort(e), e) then 1
      else if not TEST_LIST.same(QUICKSORT.sort(one), one) then 2
      else if not TEST_LIST.same(QUICKSORT.sort(sorted_in), sorted_in) then 3
      else if not TEST_LIST.same(QUICKSORT.sort(rev_in), rev_exp) then 4
      else if not TEST_LIST.same(s_dup, dup_exp) then 5
      else if not TEST_LIST.same(QUICKSORT.sort(same_in), same_in) then 6
      else if not TEST_LIST.same(QUICKSORT.sort(two_in), two_exp) then 7
      else if not TEST_LIST.same(QUICKSORT.below(3, part_in), lo_exp) then 8
      else if not TEST_LIST.same(QUICKSORT.at_or_above(3, part_in), hi_exp) then 9
      else if not QUICKSORT.all_lt(3, lo_exp) then 10
      else if QUICKSORT.all_lt(3, hi_exp) then 11
      else if not INSERTION_SORT.is_sorted(s_dup) then 12
      else if not TEST_LIST.same(QUICKSORT.sort(str_in), str_exp) then 13
      else if big_qs.length != 1500 then 14
      else if not INSERTION_SORT.is_sorted(big_qs) then 15
      else if not TEST_LIST.same(big_qs, big_ms) then 16
      else if not TEST_LIST.same(QUICKSORT.sort(asc), asc) then 17
      else 0
      end end end end end end end end end end end end end end end end end
    end

end
