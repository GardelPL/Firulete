-- Tests for `GCD` (`src/gcd.gdl`). See `insertion_sort_test.gdl` for the conventions.
functions GCD_TEST

feature {ANY}

  -- ---------------------------------------------------------------- spec tests (static)

  -- From the contracts and the `greatest` law: `6` divides `gcd(12, 18)`, which divides both.
  spec_concrete: BOOL
    do
      check
        s1_common: GCD.divides(6, 12) and GCD.divides(6, 18)
        s1_greatest: GCD.divides(6, GCD.gcd(12, 18))
        s1_divides: GCD.divides(GCD.gcd(12, 18), 12) and GCD.divides(GCD.gcd(12, 18), 18)
        s1_zero_right: GCD.gcd(12, 0) = 12
        s1_zero_left: GCD.gcd(0, 7) = 7
      end
      True
    ensure
      holds: Result
    end

  -- For all inputs: a common divisor, the greatest one, and Bezout's identity.
  spec_gcd(a: NAT, b: NAT, d: NAT): BOOL
    do
      check s2_bezout: GCD.bezout(a, b) end
      True
    ensure
      holds: Result
      divides_both: GCD.divides(GCD.gcd(a, b), a) and GCD.divides(GCD.gcd(a, b), b)
      greatest: (GCD.divides(d, a) and GCD.divides(d, b)) implies GCD.divides(d, GCD.gcd(a, b))
      bezout: a * GCD.bezout_x(a, b) + b * GCD.bezout_y(a, b) = GCD.gcd(a, b)
    end

  -- ---------------------------------------------------------------- run tests (executed)

  run: NAT
    do
      if GCD.gcd(12, 18) != 6 then 1
      else if GCD.gcd(18, 12) != 6 then 2
      else if GCD.gcd(0, 0) != 0 then 3
      else if GCD.gcd(0, 9) != 9 or GCD.gcd(9, 0) != 9 then 4
      else if GCD.gcd(17, 5) != 1 then 5
      else if GCD.gcd(1071, 462) != 21 then 6
      else if GCD.gcd(1000, 1000) != 1000 then 7
      else if not GCD.divides(7, 49) or GCD.divides(7, 50) then 8
      else if not GCD.divides(0, 0) or GCD.divides(0, 3) then 9
      else 0
      end end end end end end end end end
    end

end
